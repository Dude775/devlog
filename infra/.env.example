POSTGRES_USER=devlog
# Local dev: apps/api/.env.example DATABASE_URL uses this password (pnpm dev:setup)
POSTGRES_PASSWORD=change-me
POSTGRES_DB=devlog
POSTGRES_PORT=5432
# Browser origin allowed by the api's CORS policy
WEB_ORIGIN=http://localhost:3000
# Browser-facing api URL, inlined into the web bundle at build time
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secrets (min 32 chars). Generate with: openssl rand -hex 32
VIEW_HASH_SALT=change-me-to-a-random-64-char-hex-string-0000000000
ADMIN_API_KEY=
# Optional registry mirrors (e.g. when Docker Hub rate-limits)
# NODE_IMAGE=mirror.gcr.io/library/node:22-alpine
# POSTGRES_IMAGE=mirror.gcr.io/library/postgres:16-alpine
