# Server-only: base URL the Next.js server uses to reach apps/api
API_URL=http://localhost:4000
# Public canonical site URL (used for metadata/SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public: base URL the browser uses to reach apps/api (must be allowed by the api's WEB_ORIGIN)
NEXT_PUBLIC_API_URL=http://localhost:4000
