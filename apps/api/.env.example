NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
DATABASE_URL=postgres://devlog:change-me@localhost:5432/devlog
# Allowed browser origin(s) for CORS, comma-separated
WEB_ORIGIN=http://localhost:3000
# Enables GET /v1/stats (header x-admin-api-key). Min 32 chars. Generate: openssl rand -hex 32
ADMIN_API_KEY=
# HMAC secret for unique-visitor hashes. Required in production. Min 32 chars.
VIEW_HASH_SALT=
# Trust X-Forwarded-For for client IP (only behind a reverse proxy you control)
TRUST_PROXY=false
