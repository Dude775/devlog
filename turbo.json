{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.json"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "!README.md"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", ".velite/**", "public/static/**"],
      "env": ["NEXT_PUBLIC_*", "API_URL", "SITE_URL"]
    },
    "@devlog/web#build": {
      "dependsOn": ["^build", "@devlog/web#lint", "@devlog/web#typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "!README.md"],
      "outputs": [".next/**", "!.next/cache/**", ".velite/**", "public/static/**"],
      "env": ["NEXT_PUBLIC_*", "API_URL", "SITE_URL"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": ["TEST_DATABASE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "env": ["CI"],
      "passThroughEnv": ["PLAYWRIGHT_*"]
    }
  }
}
